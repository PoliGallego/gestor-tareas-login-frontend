# ------------------------------------------------------------------
# Variables de entorno del frontend de Login
# Copia este archivo como `.env` y ajusta los valores segun el entorno
# (local, otra maquina de la red, contenedor, etc.).
#
# IMPORTANTE: Vite solo expone al navegador las variables con prefijo
# VITE_. Sus valores quedan incrustados en el bundle al hacer `build`,
# asi que NUNCA pongas aqui secretos (claves, passwords, tokens).
# ------------------------------------------------------------------

# Microservicio de autenticacion (backend)
VITE_AUTH_API_URL=http://localhost:8090

# Frontend del gestor de tareas (redireccion tras login exitoso)
VITE_TASKS_APP_URL=http://localhost:5173

# Frontend de registro de usuarios
VITE_SIGNUP_APP_URL=http://localhost:3010

# Puerto y host del servidor de desarrollo de este frontend
# (HOST=0.0.0.0 permite acceder desde otras maquinas de la red)
PORT=3000
HOST=localhost
